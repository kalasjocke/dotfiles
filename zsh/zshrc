# Setup brew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Load the pure prompt
autoload -Uz promptinit; promptinit
prompt pure

# Init the completion system
autoload -Uz compinit; compinit

# Make completion incasesensitive
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Make sure the completion menu shows
zstyle ':completion:*' menu select

# Make shift tab traverse completion menu in reverse order
zmodload zsh/complist
bindkey -M menuselect '^[[Z' reverse-menu-complete

# Some aliases
alias gs="git status"
alias gc="git commit --verbose"
alias gcp="gh pr view --json "url" | jq -r ".url" | pbcopy"
alias ga="git add"
alias gb="git branch"
alias gd="git diff"
alias gco="git checkout"
alias grm="git rm"
alias gr="git rebase"
alias gst="git stash"
alias gstp="git stash pop"
alias grc="git rebase --continue"
alias gra="git rebase --abort"
alias gpfwl="git push --force-with-lease"
alias gclean="git branch --merged | egrep -v master | egrep -v main | xargs git branch -d"
alias gl='git log --graph --all --pretty=format:"%Cblue%h%Creset %s%C(yellow)%d%Creset (%Cgreen%an%Creset, %C(cyan)%ar%Creset)"'
alias gri='git rebase -i --autosquash `git merge-base main HEAD`'
alias ggpull="git pull origin \$(git rev-parse --abbrev-ref HEAD)"
alias ggpush="git push origin \$(git rev-parse --abbrev-ref HEAD)"
alias tc="tmux show-buffer | pbcopy"
alias c="clear"
alias l="ls -GFlash"
alias tree="tree -C"
alias ..="cd .."
alias cc="claude"

# Keyboard timeout
export KEYTIMEOUT=1

# Use nvim
export EDITOR=nvim
alias vim="nvim"

export LANG=en_US.UTF-8

# Configure history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt share_history
setopt hist_ignore_dups
setopt hist_save_no_dups
setopt hist_find_no_dups
setopt hist_ignore_all_dups

# fzf zsh integration
export FZF_DEFAULT_OPTS="--no-separator"
export FZF_CTRL_R_OPTS='--height 12'
source <(fzf --zsh)

# Find and replace across files: agr <from> <to>
function agr { rg -0 -l "$1" . | AGR_FROM="$1" AGR_TO="$2" xargs -0 perl -pi -e 's/$ENV{AGR_FROM}/$ENV{AGR_TO}/g'; }

# cd to where the Claude Code session in this tmux window is working. Claude
# records each session's folder in ~/.claude/sessions/<pid>.json, and titles
# the pane showing a session with the session's name, sometimes after a status
# symbol like "✳ ". A session can also work elsewhere by starting its shell
# commands with cd, so the end of its transcript decides: the last cd or
# change of the session's folder wins.
function cdc {
  local pane tty title dir sid cwd last
  local -a transcript
  while IFS=$'\t' read -r pane tty title dir; do
    ps -t "$tty" -o args= | grep -qE '(^|/)claude( |$)' || continue
    IFS=$'\t' read -r sid cwd < <(jq -rs --arg t "$title" --arg p "$pane" '
      (map(select((.name // "") as $n | $n != "" and ($t == $n or ($t | endswith(" " + $n)))))
        | sort_by(-(.updatedAt // 0)))
      + map(select((.tmux // "") | endswith("." + $p)))
      | .[0] // empty | "\(.sessionId)\t\(.cwd)"' ~/.claude/sessions/*.json(N) 2>/dev/null)
    transcript=(~/.claude/projects/*/$sid.jsonl(N))
    if [[ -n $sid && -n $transcript ]]; then
      last=$(tail -n 300 $transcript[1] | jq -Rr '
        fromjson? | (.cwd // empty | "cwd\t\(.)"),
        (.message.content[]? | select(.type? == "tool_use" and .name == "Bash") | .input.command
          | scan("(?:^|[;&|(]\\s*)cd\\s+(\"[^\"]+\"|[~/][^\\s;&|)]*)") | "cd\t\(.[0])")' |
        awk -F'\t' '$1 == "cwd" { if ($2 != prev) last = prev = $2; next } { last = $2 } END { print last }')
      last=${${last#\"}%\"}
      last=${last/#\~/$HOME}
      [[ -d $last ]] && cwd=$last
    fi
    cd "${cwd:-$dir}" && return
  done < <(tmux list-panes -t "$TMUX_PANE" -F $'#{pane_id}\t#{pane_tty}\t#{pane_title}\t#{pane_current_path}')
  echo "No Claude Code session in this tmux window" >&2
  return 1
}

