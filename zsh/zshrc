# Setup brew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Load the pure prompt
autoload -Uz promptinit; promptinit
prompt pure

# Init the completion system
autoload -Uz compinit; compinit

# Make completion incasesensitive
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Make sure the completion menu shows
zstyle ':completion:*' menu select

# Make shift tab traverse completion menu in reverse order
zmodload zsh/complist
bindkey -M menuselect '^[[Z' reverse-menu-complete

# Some aliases
alias gs="git status"
alias gc="git commit --verbose"
alias gcp="gh pr view --json "url" | jq -r ".url" | pbcopy"
alias ga="git add"
alias gb="git branch"
alias gd="git diff"
alias gco="git checkout"
alias grm="git rm"
alias gr="git rebase"
alias gst="git stash"
alias gstp="git stash pop"
alias grc="git rebase --continue"
alias gra="git rebase --abort"
alias gpfwl="git push --force-with-lease"
alias gclean="git branch --merged | egrep -v master | egrep -v main | xargs git branch -d"
alias gl='git log --graph --all --pretty=format:"%Cblue%h%Creset %s%C(yellow)%d%Creset (%Cgreen%an%Creset, %C(cyan)%ar%Creset)"'
alias gri='git rebase -i --autosquash `git merge-base main HEAD`'
alias ggpull="git pull origin \$(git rev-parse --abbrev-ref HEAD)"
alias ggpush="git push origin \$(git rev-parse --abbrev-ref HEAD)"
alias tc="tmux show-buffer | pbcopy"
alias c="clear"
alias l="ls -GFlash"
alias tree="tree -C"
alias ..="cd .."
alias cc="claude"

# Keyboard timeout
export KEYTIMEOUT=1

# Use nvim
export EDITOR=nvim
alias vim="nvim"

export LANG=en_US.UTF-8

# Configure history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt share_history
setopt hist_ignore_dups
setopt hist_save_no_dups
setopt hist_find_no_dups
setopt hist_ignore_all_dups

# fzf zsh integration
export FZF_DEFAULT_OPTS="--no-separator"
export FZF_CTRL_R_OPTS='--height 12'
source <(fzf --zsh)

# Find and replace across files: agr <from> <to>
function agr { rg -0 -l "$1" . | AGR_FROM="$1" AGR_TO="$2" xargs -0 perl -pi -e 's/$ENV{AGR_FROM}/$ENV{AGR_TO}/g'; }

# cd to the current folder of the Claude Code session in this tmux window.
# Claude records each session's folder in ~/.claude/sessions/<pid>.json, and
# titles the pane showing a session with the session's name, sometimes after a
# status symbol like "✳ ".
function cdc {
  local pane tty title dir cwd
  while IFS=$'\t' read -r pane tty title dir; do
    ps -t "$tty" -o args= | grep -qE '(^|/)claude( |$)' || continue
    cwd=$(jq -rs --arg t "$title" --arg p "$pane" '
      (map(select((.name // "") as $n | $n != "" and ($t == $n or ($t | endswith(" " + $n)))))
        | sort_by(-(.updatedAt // 0)))
      + map(select((.tmux // "") | endswith("." + $p)))
      | .[0].cwd // empty' ~/.claude/sessions/*.json(N) 2>/dev/null)
    cd "${cwd:-$dir}" && return
  done < <(tmux list-panes -t "$TMUX_PANE" -F $'#{pane_id}\t#{pane_tty}\t#{pane_title}\t#{pane_current_path}')
  echo "No Claude Code session in this tmux window" >&2
  return 1
}

# Enable vim mode
bindkey -v

# fnm
eval "$(fnm env)"

# Add our own bin to path"
export PATH="$HOME/.bin:$PATH"

# Postgres
export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"

# Rust
export PATH="$HOME/.cargo/bin:$PATH"

# Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# Claude
export PATH="$HOME/.local/bin:$PATH"

# Source machine-specific secrets
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

