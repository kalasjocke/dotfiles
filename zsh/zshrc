eval "$(fnm env)"

# Add our own bin to path"
export PATH="$HOME/.bin:$PATH"

# Postgres
export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"

# Rust
export PATH="$HOME/.cargo/bin:$PATH"

# Bun
export BUN_INSTALL="$HOME/.bun"
