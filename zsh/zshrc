# Setup brew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Load the pure prompt
autoload -Uz promptinit; promptinit
prompt pure

# Init the completion system
autoload -Uz compinit; compinit

# Make completion incasesensitive
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Make sure the completion menu shows
zstyle ':completion:*' menu select

# Make shift tab traverse completion menu in reverse order
zmodload zsh/complist
bindkey -M menuselect '^[[Z' reverse-menu-complete

# Some aliases
alias gs="git status"
alias gc="git commit --verbose"
alias gcp="gh pr view --json "url" | jq -r ".url" | pbcopy"
alias ga="git add"
alias gb="git branch"
alias gd="git diff"
alias gco="git checkout"
alias grm="git rm"
alias gr="git rebase"
alias gst="git stash"
alias gstp="git stash pop"
alias grc="git rebase --continue"
alias gra="git rebase --abort"
alias gpfwl="git push --force-with-lease"
alias gclean="git branch --merged | egrep -v master | egrep -v main | xargs git branch -d"
alias gl='git log --graph --all --pretty=format:"%Cblue%h%Creset %s%C(yellow)%d%Creset (%Cgreen%an%Creset, %C(cyan)%ar%Creset)"'
alias gri='git rebase -i --autosquash `git merge-base main HEAD`'
alias ggpull="git pull origin \$(git rev-parse --abbrev-ref HEAD)"
alias ggpush="git push origin \$(git rev-parse --abbrev-ref HEAD)"
alias tc="tmux show-buffer | pbcopy"
alias c="clear"
alias l="ls -GFlash"
alias tree="tree -C"
alias ..="cd .."
alias cc="claude"

# Keyboard timeout
export KEYTIMEOUT=1

# Use nvim
export EDITOR=nvim
alias vim="nvim"

export LANG=en_US.UTF-8

# Configure history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt share_history
setopt hist_ignore_dups
setopt hist_save_no_dups
setopt hist_find_no_dups
setopt hist_ignore_all_dups

# fzf zsh integration
export FZF_DEFAULT_OPTS="--no-separator --color=base16"
[ -n "$REX_SESSION" ] && FZF_DEFAULT_OPTS+=" --color=gutter:#373737,bg+:#373737"
export FZF_CTRL_R_OPTS='--height 12'
source <(fzf --zsh)

# Find and replace across files: agr <from> <to>
function agr { rg -0 -l "$1" . | AGR_FROM="$1" AGR_TO="$2" xargs -0 perl -pi -e 's/$ENV{AGR_FROM}/$ENV{AGR_TO}/g'; }

# cd to the folder, worktree or not, of the Claude Code session in this Rex tab
# or tmux window. Claude records each session in ~/.claude/sessions/<pid>.json,
# keyed by the pid of the claude process in the pane. A pane showing a
# background session runs a separate claude process, though, and only the pane
# title links the two: Claude titles the pane with the background session's
# name, sometimes after a status symbol like "✳ ", and tab-name.sh adds the
# context size after it in Rex, like "dotfiles (76k)". The folder is the one
# the session started in, unless the transcript's last entry is in another
# worktree of the same repo. That covers worktrees from Claude's own worktree
# tool and ones a session made with git and cd'd into. A cd into a subfolder or
# another repo doesn't count.
function cdw {
  if [[ -n $REX_BLOCK ]]; then
    _cdw_rex
  elif [[ -n $TMUX_PANE ]]; then
    _cdw_tmux
  else
    echo "cdw works only in Rex or tmux" >&2
    return 1
  fi
}

# Print the folder of the Claude Code session with this pid or pane title.
function _cdw_dir {
  local pid=$1 title=$2 sid cwd last root
  local -a transcript
  IFS=$'\t' read -r sid cwd < <(jq -rs --arg t "$title" --argjson p "$pid" '
    (map(select(.kind == "bg" and ((.name // "") as $n
      | $n != "" and ($t == $n or ($t | endswith(" " + $n))
        or ($t | startswith($n + " ("))))))
      | sort_by(-(.updatedAt // 0)))
    + map(select(.pid == $p))
    | .[0] // empty | "\(.sessionId)\t\(.cwd)"' ~/.claude/sessions/*.json(N) 2>/dev/null)
  transcript=(~/.claude/projects/*/$sid.jsonl(N))
  if [[ -n $sid && -n $transcript && -d $cwd ]]; then
    last=$(tail -n 200 $transcript[1] | grep -o '"cwd":"[^"]*"' | tail -1 | cut -d'"' -f4)
    root=$(git -C "$last" rev-parse --show-toplevel 2>/dev/null)
    if [[ -n $root && $root != $(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) &&
      $(git -C "$last" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) == \
      $(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ]]; then
      cwd=$root
    fi
  fi
  print -r -- "$cwd"
}

# Rex reports each pane's foreground program with its pid and folder.
function _cdw_rex {
  local window block label pid dir cwd
  window=$(rex block ls -s "$REX_SESSION" --json |
    jq -r --arg b "$REX_BLOCK" '.blocks[] | select(.block_id == $b) | .window_id')
  while IFS=$'\t' read -r block label; do
    IFS=$'\t' read -r pid dir < <(rex block call -s "$REX_SESSION" -b "$block" process |
      jq -r '.foreground | select(.argv0 == "claude" or ((.invoked_path // "") | endswith("/claude")))
        | "\(.pid)\t\(.cwd)"')
    [[ -n $pid ]] || continue
    cwd=$(_cdw_dir "$pid" "$label")
    cd "${cwd:-$dir}" && return
  done < <(rex block ls -s "$REX_SESSION" --json |
    jq -r --arg w "$window" '.blocks[] | select(.window_id == $w) | "\(.block_id)\t\(.label // "")"')
  echo "No Claude Code session in this Rex tab" >&2
  return 1
}

# tmux gives each pane's tty, and ps finds the claude process on it.
function _cdw_tmux {
  local pane tty title dir pid cwd
  while IFS=$'\t' read -r pane tty title dir; do
    pid=$(ps -t "$tty" -o pid=,args= |
      awk '{ a = $0; sub(/^ *[0-9]+ /, "", a) } a ~ /(^|\/)claude( |$)/ { print $1; exit }')
    [[ -n $pid ]] || continue
    cwd=$(_cdw_dir "$pid" "$title")
    cd "${cwd:-$dir}" && return
  done < <(tmux list-panes -t "$TMUX_PANE" -F $'#{pane_id}\t#{pane_tty}\t#{pane_title}\t#{pane_current_path}')
  echo "No Claude Code session in this tmux window" >&2
  return 1
}

